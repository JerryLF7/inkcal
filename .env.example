# ── Photo source ─────────────────────────────────────────────────────
# Choose which photo library(ies) to sync from. Comma-separated list.
# Supported values: immich, photoprism
# Examples:
#   SOURCE=immich               # Immich only (default if not set but IMMICH_API_KEY present)
#   SOURCE=photoprism           # PhotoPrism only
#   SOURCE=immich,photoprism    # Both
SOURCE=immich

# Immich
IMMICH_URL=http://immich.local:2283
IMMICH_API_KEY=your_immich_api_key

# PhotoPrism (only needed if SOURCE includes "photoprism")
# PHOTOPRISM_URL=https://photos.example.com
# PHOTOPRISM_API_KEY=your_app_password

# Gemini (OpenAI-compatible format)
GEMINI_API_KEY=your_api_key
GEMINI_BASE_URL=https://your-api-endpoint/v1
GEMINI_MODEL=gemini-3-flash-preview

# Luna (session agent, OpenAI-compatible format) — 与 Gemini 分开
LUNA_API_KEY=
LUNA_BASE_URL=https://api.openlux.ai/v1
LUNA_MODEL=gpt-5.6-luna

# 本地 SigLIP2 判定食物的阈值（0~1 的**小数**）。改完即生效，不用重启：
# 长驻的 Web 进程每次分类都重读 .env，cron 本来就是一个进程跑一次。
# 想写百分比请写 0.45 而不是 45（非法值会回退默认并告警，不会静默生效）。
# 调高会连真食物一起拦掉：实测漏放的非食物中位数 0.78、真食物 0.79，几乎重合，
# 往上调救不回漏检。没有新标定数据就别动。
FOOD_THRESHOLD=0.35

# Agent layer — set to 1 to route filtered food photos through the Luna
# harness (same-meal grouping + Gemini as expert tool). On any harness
# failure the pipeline falls back to the legacy single-photo Gemini path.
AGENT_ENABLED=0

# Web auth — leave both empty to disable login,
# or set BOTH (server refuses to start with only one).
# Use a strong, unique password. Default is rate-limited to 5 attempts/5min/IP.
INKCAL_USER=
INKCAL_PASS=

# Flask session signing key. MUST be a long random string and stable across restarts;
# changing it logs everyone out. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
INKCAL_SECRET=

# Luna batch size: photos per harness run (default 6).
# AGENT_BATCH_SIZE=6

# Web server bind address. Default is 127.0.0.1 (local only — recommended).
# To allow LAN access, set to 0.0.0.0 OR put behind a reverse proxy on the host.
INKCAL_HOST=127.0.0.1
INKCAL_PORT=5800

# Set to 1 only when serving via HTTPS reverse proxy — adds Secure flag to session cookies.
INKCAL_HTTPS=0

# Flask debug mode (default 0). Never enable when exposed beyond localhost.
INKCAL_DEBUG=0

# Override the SQLite path (default: data/inkcal.db). Tests use this for isolation.
# INKCAL_DB=

<?xml version="1.0" encoding="utf-8"?>
<!--
  服务器地址由用户在 App 里填写，所以这里**不做地址白名单**：白名单要求把真实域名/IP
  写进仓库和 APK，而 APK 是公开下载的，等于把内网拓扑一起发出去；而且
  network-security-config 不支持网段，换地址就得改代码重新发版。

  cleartextTrafficPermitted 目前是 true，因为自建服务可能只有 HTTP（反代只做转发
  没上 TLS）。**如果服务器已经上了 HTTPS，把这里改成 false 收紧**——改完要重新构建。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
